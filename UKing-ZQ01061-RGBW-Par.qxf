<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>4.12.7</Version>
  <Author>LeQueb (manuel U`King ZQ01061 10Wx18 RGBW)</Author>
 </Creator>
 <Manufacturer>UKing</Manufacturer>
 <Model>ZQ01061 RGBW Par</Model>
 <Type>Color Changer</Type>
 <Channel Name="Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="9" Preset="ShutterOpen">Pas de strobe</Capability>
  <Capability Min="10" Max="255" Preset="StrobeSlowToFast">Strobe lent → rapide</Capability>
 </Channel>
 <Channel Name="Function">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="50">Contrôle DMX (canaux 1-6)</Capability>
  <Capability Min="51" Max="100">Couleurs fixes</Capability>
  <Capability Min="101" Max="150">Saut de couleurs</Capability>
  <Capability Min="151" Max="200">Fondu de couleurs</Capability>
  <Capability Min="201" Max="255">Pulse / son</Capability>
 </Channel>
 <Channel Name="Function Speed" Preset="SpeedEffectSlowToFast"/>
 <Mode Name="8 Channel">
  <Channel Number="0">Dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">White</Channel>
  <Channel Number="5">Strobe</Channel>
  <Channel Number="6">Function</Channel>
  <Channel Number="7">Function Speed</Channel>
 </Mode>
 <Mode Name="4 Channel">
  <Channel Number="0">Red</Channel>
  <Channel Number="1">Green</Channel>
  <Channel Number="2">Blue</Channel>
  <Channel Number="3">White</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="4500" ColourTemperature="0"/>
  <Dimensions Weight="2" Width="250" Height="250" Depth="150"/>
  <Lens Name="PC" DegreesMin="25" DegreesMax="25"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="200" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
